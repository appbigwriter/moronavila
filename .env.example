NODE_ENV=production
APP_ENV=production
PORT=3000
HOST=0.0.0.0

# ── IDENTIDADE & CONTROL TOWER ────────────────────────────────────────────────────────
CONTROL_TOWER_BASE_URL=https://control-tower.fbr.news
CONTROL_TOWER_PROJECT_ID=0fcc4832-7f91-432b-b3d7-65e84082c590
CONTROL_TOWER_SCHEMA_NAME=custom_moronavila

# ── SUPABASE CENTRAL & SCHEMA EXCLUSIVO ────────────────────────────────────────────────
