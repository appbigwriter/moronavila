VITE_SUPABASE_URL=https://supabase-control-tower-api.fbr.news
VITE_SUPABASE_ANON_KEY=informe_sua_anon_key_aqui
VITE_SUPABASE_SCHEMA=custom_moronavila

# Variáveis do Servidor / Backend (Nunca expor no bundle frontend)
SUPABASE_URL=https://supabase-control-tower-api.fbr.news
SUPABASE_ANON_KEY=informe_sua_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=informe_sua_service_role_key_aqui
DATABASE_URL=postgresql://postgres:senha@host:5432/postgres?search_path=custom_moronavila

# ── TOKENS DE AUTORIDADE (BACKEND / RUNTIME) ──────────────────────────────────────────
AUTHORITY_ADMIN_TOKEN=
AUTHORITY_OPERATOR_TOKEN=
AUTHORITY_REVIEWER_TOKEN=
AUTHORITY_PUBLISHER_TOKEN=
AUTHORITY_VIEWER_TOKEN=

# ── INTEGRAÇÕES OPCIONAIS (IA, FINANCEIRO, SOFTPHONE) ──────────────────────────────────
GEMINI_API_KEY=
OPENAI_SECRET_KEY=
ASAAS_WEBHOOK_SECRET=

# Softphone / PBX
VITE_SOFTPHONE_ENABLED=false
VITE_SOFTPHONE_AUTO_CONNECT=true
VITE_SOFTPHONE_REQUIRE_INTERNET_ACTIVE=true
VITE_SOFTPHONE_PBX_HOST=pbx.moronavila.local
VITE_SOFTPHONE_PBX_DOMAIN=pbx.moronavila.local
VITE_SOFTPHONE_PBX_WSS_URL=wss://pbx.moronavila.local:8089/ws
VITE_SOFTPHONE_DEFAULT_DISPLAY_NAME=MoronaVila Softphone
VITE_SOFTPHONE_TRANSPORT=mock
SOFTPHONE_PBX_DEFAULT_SECRET=trocar-quando-o-pbx-estiver-pronto
VITE_SOFTPHONE_PORTARIA_EXTENSION=100
VITE_SOFTPHONE_ADMIN_EXTENSION=101
VITE_SOFTPHONE_LAUNDRY_EXTENSION=102
VITE_SOFTPHONE_DELIVERY_EXTENSION=103
VITE_SOFTPHONE_DOOR_MODE=none
VITE_SOFTPHONE_DOOR_LABEL=Abrir porta
VITE_SOFTPHONE_DOOR_DTMF=9
